diff --git a/src/Functions/assessmentText.ts b/src/Functions/assessmentText.ts
new file mode 100644
index 0000000..454abc4
--- /dev/null
+++ b/src/Functions/assessmentText.ts
@@ -0,0 +1,92 @@
+import type { processAssessment } from "../Outlier Flagging/processAssessment";
+
+/**
+ * Teksten bag en vurdering, ordret efter "Specifikation til SPC
+ * Oversigtsvisning". Tallene og de formaterede værdier leveres udefra, så
+ * funktionen ikke selv kender til decimaler eller procenttegn.
+ */
+
+export type assessmentTextContext = {
+  /** Antal målinger i serien. */
+  n_points: number;
+  longest_run: number | null;
+  longest_run_max: number | null;
+  n_crossings: number | null;
+  n_crossings_min: number | null;
+  /** Centerlinjen, formateret som på y-aksen. */
+  centerline_text: string;
+  /** Udviklingsmålet, formateret som på y-aksen. Tomt, hvis der intet mål er. */
+  target_text: string;
+  /** "median" på et seriediagram, ellers "centerlinje". */
+  centerline_noun?: string;
+};
+
+const NL: string = "\n";
+
+const RUN_CHART_FOOTER: string =
+  "OM RUN-CHARTS" + NL +
+  "Ud fra antallet af enkeltmålinger i grafen beregnes, hvor mange kryds af medianen, " +
+  "man som minimum vil se i en proces der udviser naturlig (tilfældig) variation. " +
+  "På samme måde beregnes hvad det maksimale antal af fortløbende enkeltmålinger " +
+  "(forløb/runs), der ikke krydser medianen, vil være i en proces, der udviser " +
+  "naturlig variation. Er der enten for få kryds af medianen eller for lange forløb, " +
+  "er det et signal om en ustabil proces, altså en proces der udviser ikke-tilfældig variation.";
+
+function countText(value: number | null): string {
+  return value === null ? "–" : `${value}`;
+}
+
+function statsBlock(ctx: assessmentTextContext): string {
+  return "Faktisk / Forventet v. naturlig variation *" + NL +
+    `• Længste forløb: ${countText(ctx.longest_run)} (forventet <= ${countText(ctx.longest_run_max)})` + NL +
+    `• Antal kryds: ${countText(ctx.n_crossings)} (forventet >= ${countText(ctx.n_crossings_min)})` + NL +
+    `* ved en tidsserie på ${ctx.n_points} målinger.`;
+}
+
+function reasonText(assessment: processAssessment, ctx: assessmentTextContext, definite: string): string {
+  const kryds: string = `for få (${countText(ctx.n_crossings)}) kryds på tværs af ${definite}`;
+  const forloeb: string = `mindst ét langt forløb på ${countText(ctx.longest_run)} enkeltmålinger i træk over/under ${definite}`;
+  if (assessment.reasons.few_crossings && assessment.reasons.long_run) {
+    return `${kryds} og ${forloeb}`;
+  }
+  return assessment.reasons.few_crossings ? kryds : forloeb;
+}
+
+export function buildAssessmentText(assessment: processAssessment, ctx: assessmentTextContext): string {
+  const noun: string = ctx.centerline_noun ?? "median";
+  const definite: string = noun.endsWith("e") ? `${noun}n` : `${noun}en`;
+  const header = (status: string, subtitle: string): string =>
+    `VURDERING: ${status}` + NL + subtitle + NL + NL;
+  const tail: string = NL + NL + statsBlock(ctx) + NL + NL + RUN_CHART_FOOTER;
+  const unstable: string = "Run-charten viser en ustabil proces, da der ses " +
+                           reasonText(assessment, ctx, definite) + ".";
+  const stable: string = "Run-charten viser en stabil proces med naturlig variation.";
+  const capDefinite: string = definite.charAt(0).toUpperCase() + definite.slice(1);
+
+  switch (assessment.case) {
+    case "unstable_undesired":
+      return header("REAGÉR", "Ustabil proces i uønsket udvikling") + unstable +
+        " I bør derfor undersøge, hvad der forårsager forringelsen, for at stoppe faldet i kvalitet." + tail;
+    case "unstable_desired":
+      return header("STUDÉR", "Ustabil proces i positiv udvikling") + unstable +
+        " Udviklingen trækker resultatet i en ønsket retning. I bør derfor studere processen " +
+        "for at finde ud af, præcis hvad der har skabt denne forbedring." + tail;
+    case "unstable_unknown_direction":
+      return header("STUDÉR", "Ustabil proces") + unstable +
+        " Det kan ikke afgøres, om udsvinget går i en ønsket eller uønsket retning, fordi udviklingsmålets " +
+        "retning ikke er angivet, eller fordi det seneste punkt ligger på " + definite + ". " +
+        "I bør studere processen for at afgøre årsagen til det ikke-tilfældige udsving." + tail;
+    case "stable_target_missed":
+      return header("STUDÉR", "Stabil proces, men udviklingsmål ikke nået") + stable +
+        ` Indikatorens ${noun} (${ctx.centerline_text}) opnår imidlertid ikke udviklingsmålet på ${ctx.target_text}. ` +
+        "I bør derfor studere arbejdsgangene nærmere for at identificere årsager for at løfte niveauet." + tail;
+    case "stable_target_met":
+      return header("OBSERVÉR", "Stabil proces og udviklingsmål opnået") + stable +
+        ` ${capDefinite} (${ctx.centerline_text}) opfylder udviklingsmålet på ${ctx.target_text}. ` +
+        "Man bør derfor fortsætte den løbende overvågning." + tail;
+    case "stable_no_target":
+      return header("OBSERVÉR", "Stabil proces (intet udviklingsmål angivet)") + stable +
+        ` ${capDefinite} ligger på ${ctx.centerline_text}. ` +
+        "Da der ikke er opsat et udviklingsmål, bør man fortsætte den løbende overvågning." + tail;
+  }
+}
diff --git a/src/Outlier Flagging/processAssessment.ts b/src/Outlier Flagging/processAssessment.ts
new file mode 100644
index 0000000..4a1286a
--- /dev/null
+++ b/src/Outlier Flagging/processAssessment.ts	
@@ -0,0 +1,142 @@
+/**
+ * Vurdering af en proces som Reagér, Studér eller Observér, efter
+ * "Specifikation til SPC Oversigtsvisning".
+ *
+ * Funktionen er ren: ingen D3, ingen Power BI-typer. Den får tallene fra
+ * Anhøj-analysen (anhojRunsAnalysis) og fra diagrammets linjer og returnerer
+ * kun, hvilken vurdering der gælder og hvorfor. Teksterne bygges i
+ * assessmentText.ts.
+ *
+ * Fire forhold afgør vurderingen:
+ *   1. Er processen stabil? (Ingen lang serie og ikke for få kryds.)
+ *   2. Hvad er udviklingsmålet?
+ *   3. Er en høj eller en lav værdi god? (Udviklingsmålets retning.)
+ *   4. Ligger det seneste punkt i en ønsket eller uønsket retning ift.
+ *      centerlinjen?
+ */
+
+export type processStatus = "reagér" | "studér" | "observér";
+
+/**
+ * Hvilket af spec'ens fem tilfælde, der gælder. Teksten vælges ud fra denne,
+ * ikke ud fra statusordet, fordi to tilfælde giver Studér og to giver
+ * Observér/Studér med hvert sit budskab.
+ */
+export type assessmentCase =
+  | "unstable_undesired"
+  | "unstable_desired"
+  | "unstable_unknown_direction"
+  | "stable_target_missed"
+  | "stable_target_met"
+  | "stable_no_target";
+
+/** Hvilken vej der er den gode, afledt af udviklingsmålets retning. */
+export type improvementDirection = "higher" | "lower" | "unknown";
+
+/** Færrest målinger, før en vurdering giver mening (samme grænse som DAX-measuren). */
+export const MIN_POINTS_FOR_ASSESSMENT: number = 6;
+
+export type assessmentInput = {
+  /** Antal målinger i serien, før punkter på centerlinjen fjernes. */
+  n_points: number;
+  /** Har Anhøj-reglen om lange serier slået til (og er den slået til i indstillingerne)? */
+  long_run_signal: boolean;
+  /** Har Anhøj-reglen om for få kryds slået til (og er den slået til i indstillingerne)? */
+  few_crossings_signal: boolean;
+  /** Centerlinjen i den seneste fase: medianen på et seriediagram. */
+  centerline: number | undefined;
+  /** Seneste observation. */
+  latest: number | undefined;
+  /** Udviklingsmålets værdi, hvis det findes. */
+  target: number | undefined;
+  /** Udviklingsmålets retning: ">=", "<=", ">", "<" eller "none". */
+  operator: string;
+};
+
+export type processAssessment = {
+  status: processStatus;
+  case: assessmentCase;
+  stable: boolean;
+  reasons: { few_crossings: boolean; long_run: boolean };
+};
+
+/**
+ * "Mindst" og "over" betyder, at høj er god; "højst" og "under", at lav er
+ * god. Uden retning kan det ikke afgøres, og der gættes ikke.
+ */
+export function improvementDirection(operator: string): improvementDirection {
+  if (operator === ">=" || operator === ">") {
+    return "higher";
+  }
+  if (operator === "<=" || operator === "<") {
+    return "lower";
+  }
+  return "unknown";
+}
+
+function isNumber(value: number | undefined): value is number {
+  return typeof value === "number" && Number.isFinite(value);
+}
+
+function targetMet(centerline: number, target: number, operator: string): boolean {
+  switch (operator) {
+    case ">=": return centerline >= target;
+    case ">": return centerline > target;
+    case "<=": return centerline <= target;
+    case "<": return centerline < target;
+    default: return false;
+  }
+}
+
+/**
+ * @returns Vurderingen, eller null når serien er for kort til, at den kan
+ *   vurderes (færre end MIN_POINTS_FOR_ASSESSMENT målinger).
+ */
+export function assessProcess(input: assessmentInput): processAssessment | null {
+  if (input.n_points < MIN_POINTS_FOR_ASSESSMENT) {
+    return null;
+  }
+
+  const reasons = {
+    few_crossings: input.few_crossings_signal,
+    long_run: input.long_run_signal
+  };
+  const stable: boolean = !reasons.few_crossings && !reasons.long_run;
+  const direction: improvementDirection = improvementDirection(input.operator);
+
+  if (!stable) {
+    // Udsvinget er det seneste punkts afstand til centerlinjen. Ligger det
+    // præcis på linjen, eller mangler retningen, kan udsvinget ikke kaldes
+    // hverken ønsket eller uønsket, og det forsigtige Studér gælder.
+    const hasDeviation: boolean = isNumber(input.latest) && isNumber(input.centerline)
+                                  && input.latest !== input.centerline;
+    if (direction === "unknown" || !hasDeviation) {
+      return { status: "studér", case: "unstable_unknown_direction", stable, reasons };
+    }
+    const deviation: number = (input.latest as number) - (input.centerline as number);
+    const desired: boolean = direction === "higher" ? deviation > 0 : deviation < 0;
+    return desired
+      ? { status: "studér", case: "unstable_desired", stable, reasons }
+      : { status: "reagér", case: "unstable_undesired", stable, reasons };
+  }
+
+  // Stabil proces. Et mål uden retning kan ikke vurderes og behandles som
+  // intet mål, frem for at antage en retning brugeren ikke har valgt.
+  const hasTarget: boolean = isNumber(input.target) && direction !== "unknown";
+  if (!hasTarget || !isNumber(input.centerline)) {
+    return { status: "observér", case: "stable_no_target", stable, reasons };
+  }
+  return targetMet(input.centerline, input.target as number, input.operator)
+    ? { status: "observér", case: "stable_target_met", stable, reasons }
+    : { status: "studér", case: "stable_target_missed", stable, reasons };
+}
+
+const statusLabels: Record<processStatus, string> = {
+  "reagér": "Reagér",
+  "studér": "Studér",
+  "observér": "Observér"
+};
+
+export function statusLabel(status: processStatus): string {
+  return statusLabels[status];
+}
