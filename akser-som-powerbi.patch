diff --git a/src/Functions/ptToPx.ts b/src/Functions/ptToPx.ts
new file mode 100644
index 0000000..0a2ed1d
--- /dev/null
+++ b/src/Functions/ptToPx.ts
@@ -0,0 +1,15 @@
+/**
+ * Omregn point til CSS-pixels.
+ *
+ * Power BI angiver skriftstørrelser i point (12 i formateringsruden er
+ * 12 pt = 16 px). Bruges størrelsen ufortolket som `px`, bliver teksten
+ * en fjerdedel mindre end i Power BI's egne visuals.
+ *
+ * Bruges til pladsberegninger i pixels, hvor en størrelse i punkter skal
+ * lægges sammen med en margen. Selve teksten får enheden `pt` direkte.
+ *
+ * @param points - Størrelse i point
+ */
+export default function ptToPx(points: number): number {
+  return points * 4 / 3;
+}
diff --git a/src/Functions/toFixedGrouped.ts b/src/Functions/toFixedGrouped.ts
new file mode 100644
index 0000000..21ddbc6
--- /dev/null
+++ b/src/Functions/toFixedGrouped.ts
@@ -0,0 +1,19 @@
+/**
+ * Formatér et tal på dansk: punktum som tusindtalsseparator, komma som
+ * decimalmarkør. Svarer til det, Power BI's egne akser viser i en dansk
+ * rapport (2.000, 1.250,5).
+ *
+ * Bruges til aksemærker. `toFixedComma` grupperer ikke og bruges stadig
+ * til værdietiketter, så de er uændrede.
+ *
+ * @param value - Tallet der skal formateres
+ * @param decimals - Antal decimaler
+ */
+export default function toFixedGrouped(value: number, decimals: number): string {
+  const fixed: string = Math.abs(value).toFixed(decimals);
+  const [integerPart, decimalPart] = fixed.split(".");
+  const grouped: string = integerPart.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
+  // Et tal, der afrundes til nul, må ikke få et minus (fx -0,0).
+  const sign: string = value < 0 && Number(fixed) !== 0 ? "-" : "";
+  return sign + grouped + (decimalPart === undefined ? "" : "," + decimalPart);
+}
